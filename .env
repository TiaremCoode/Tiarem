# Copiá este archivo a ".env" (sin el ".example") y completá los valores
# antes de levantar el proyecto. El archivo ".env" NUNCA se sube a git
# (ver .gitignore) porque contiene contraseñas y credenciales.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=cambiar_esta_clave_root
MYSQL_DATABASE=sgdm_db

# Contraseñas de los usuarios de aplicación (ver db/02_dcl.sh).
# Elegí valores propios, no dejes estos de ejemplo.
SGDM_APP_DB_PASSWORD=cambiar_clave_app
SGDM_READONLY_DB_PASSWORD=cambiar_clave_readonly

# ---------- Aplicación ----------
# "development" muestra, además de la pantalla de error prolija, el
# detalle técnico (mensaje, archivo y línea) para poder diagnosticar
# mientras se cursa el proyecto. Cambiar a "production" antes de
# entregar el sistema a un uso real oculta ese detalle.
APP_ENV=development

# URL pública donde vas a acceder al sitio (se usa para armar links absolutos,
# por ejemplo el redirect_uri de Google si no lo fijás aparte).
APP_URL=http://localhost:8080

# ---------- Login con Google (OAuth 2.0) ----------
# Se generan en https://console.cloud.google.com/apis/credentials
# creando un "ID de cliente de OAuth 2.0" de tipo "Aplicación web".
# En "URI de redireccionamiento autorizados" agregá exactamente:
#   http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
